# Client Expo - ces variables sont publiques (clé anon Supabase = publique par design,
# la sécurité réelle est assurée par les policies RLS côté base de données).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Ne JAMAIS mettre les variables suivantes dans le client / EXPO_PUBLIC_* ---
# Elles sont utilisées uniquement côté serveur, dans la Supabase Edge Function
# `ai-coach` (supabase/functions/ai-coach). A configurer avec:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-xxxx
# Si absente, l'Edge Function utilise automatiquement un moteur de règles
# volleyball (fallback) au lieu d'appeler un LLM externe: le Coach IA reste
# fonctionnel sans clé, la qualité des réponses s'améliore avec la clé.
ANTHROPIC_API_KEY=

# Préparé pour une future intégration de paiement (non activée) :
# STRIPE_SECRET_KEY=
